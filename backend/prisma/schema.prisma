generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id                   String    @id @default(uuid()) @db.Uuid
  email                String    @unique @db.VarChar(320)
  password_hash        String?   @db.VarChar(255)
  full_name            String    @db.VarChar(200)
  avatar_url           String?   @db.VarChar(500)
  status               String    @default("ACTIVE") @db.VarChar(30)
  must_change_password Boolean   @default(true)
  email_verified_at    DateTime?
  last_login_at        DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  deleted_at           DateTime?

  sessions             Session[]
  userRoles            UserRole[]
  notifications        Notification[]
  notificationPrefs    UserNotificationPreference[]
  auditLogs            AuditLog[]

  @@map("users")
}

model Role {
  id             String    @id @default(uuid()) @db.Uuid
  code           String    @unique @db.VarChar(50)
  name           String    @db.VarChar(100)
  description    String?   @db.Text
  is_system_role Boolean   @default(false)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  userRoles      UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id             String    @id @default(uuid()) @db.Uuid
  code           String    @unique @db.VarChar(100)
  resource       String    @db.VarChar(80)
  action         String    @db.VarChar(50)
  description    String?   @db.Text
  created_at     DateTime  @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  user_id     String   @db.Uuid
  role_id     String   @db.Uuid
  assigned_at DateTime @default(now())
  assigned_by String?  @db.Uuid

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@map("user_roles")
}

model RolePermission {
  role_id       String   @db.Uuid
  permission_id String   @db.Uuid
  created_at    DateTime @default(now())

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  user_id      String    @db.Uuid
  session_hash String    @unique @db.VarChar(128)
  created_at   DateTime  @default(now())
  expires_at   DateTime
  last_seen_at DateTime  @default(now())
  revoked_at   DateTime?
  ip_hash      String?   @db.VarChar(128)
  user_agent   String?   @db.Text

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, expires_at])
  @@map("sessions")
}

// =============================================
// Phase 2: Projects & Instruments
// =============================================

model Project {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(200)
  code            String    @unique @db.VarChar(50)
  description     String?   @db.Text
  program_studi   String    @db.VarChar(200)
  jenjang         String    @db.VarChar(20) // S1, S2, S3, D3, D4
  accreditation   String?   @db.VarChar(20) // A, B, C, Unggul, Baik Sekali, Baik
  status          String    @default("DRAFT") @db.VarChar(30) // DRAFT, ACTIVE, SUBMITTED, COMPLETED
  deadline        DateTime?
  created_by      String    @db.Uuid
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  documents       Document[]
  instruments     Instrument[]

  @@map("projects")
}

model Instrument {
  id          String    @id @default(uuid()) @db.Uuid
  project_id  String    @db.Uuid
  code        String    @db.VarChar(50)
  name        String    @db.VarChar(300)
  parent_id   String?   @db.Uuid
  level       Int       @default(0) // 0=kriteria, 1=sub, 2=indikator
  sort_order  Int       @default(0)
  description String?   @db.Text
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  project     Project    @relation(fields: [project_id], references: [id], onDelete: Cascade)
  parent      Instrument? @relation("InstrumentTree", fields: [parent_id], references: [id])
  children    Instrument[] @relation("InstrumentTree")
  documentCriteria DocumentCriteriaMapping[]

  @@unique([project_id, code])
  @@map("instruments")
}

// =============================================
// Phase 3: Documents & Knowledge Base
// =============================================

model Document {
  id              String    @id @default(uuid()) @db.Uuid
  project_id      String    @db.Uuid
  name            String    @db.VarChar(500)
  original_name   String    @db.VarChar(500)
  document_type   String    @db.VarChar(30) // DED, DKPS, EVIDENCE, SUPPORTING
  mime_type       String    @db.VarChar(100)
  file_size       BigInt
  file_path       String    @db.VarChar(1000)
  status          String    @default("UPLOADED") @db.VarChar(30) // UPLOADED, PROCESSING, PROCESSED, FAILED
  error_message   String?   @db.Text
  page_count      Int?
  uploaded_by     String    @db.Uuid
  processed_at    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  project         Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  chunks          DocumentChunk[]
  criteriaMapping DocumentCriteriaMapping[]

  @@index([project_id, document_type])
  @@index([status])
  @@map("documents")
}

model DocumentChunk {
  id              String    @id @default(uuid()) @db.Uuid
  document_id     String    @db.Uuid
  chunk_index     Int
  content         String    @db.Text
  page_number     Int?
  section_title   String?   @db.VarChar(500)
  token_count     Int       @default(0)
  char_count      Int       @default(0)
  embedding       Unsupported("vector(768)")?
  bm25_tokens     String[]  @db.Text
  metadata        Json?
  status          String    @default("INDEXED") @db.VarChar(30) // INDEXED, NEEDS_REVIEW, FAILED
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  document        Document  @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@index([document_id, chunk_index])
  @@index([status])
  @@map("document_chunks")
}

model DocumentCriteriaMapping {
  id            String    @id @default(uuid()) @db.Uuid
  document_id   String    @db.Uuid
  instrument_id String    @db.Uuid
  relevance     Float     @default(1.0) // 0.0 - 1.0, auto or manual
  assigned_by   String?   @db.Uuid // null = auto-detected
  created_at    DateTime  @default(now())

  document      Document   @relation(fields: [document_id], references: [id], onDelete: Cascade)
  instrument    Instrument @relation(fields: [instrument_id], references: [id], onDelete: Cascade)

  @@unique([document_id, instrument_id])
  @@map("document_criteria_mappings")
}

// =============================================
// Phase 4: DED Workflow
// =============================================

model DedSection {
  id              String    @id @default(uuid()) @db.Uuid
  project_id      String    @db.Uuid
  instrument_id   String    @db.Uuid  // links to criteria/dimension/indicator node
  parent_id       String?   @db.Uuid
  code            String    @db.VarChar(50)  // e.g. "1.1.1"
  title           String    @db.VarChar(500)
  description     String?   @db.Text
  level           Int       @default(0) // 0=kriteria, 1=dimensi, 2=indikator
  sort_order      Int       @default(0)
  status          String    @default("EMPTY") @db.VarChar(30) // EMPTY, DRAFT, SUBMITTED, IN_REVIEW, APPROVED, REVISION_REQUESTED
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  parent          DedSection?  @relation("DedSectionTree", fields: [parent_id], references: [id])
  children        DedSection[] @relation("DedSectionTree")
  responses       DedResponse[]

  @@index([project_id, level])
  @@unique([project_id, code])
  @@map("ded_sections")
}

model DedResponse {
  id              String    @id @default(uuid()) @db.Uuid
  section_id      String    @db.Uuid
  content         String    @db.Text
  status          String    @default("DRAFT") @db.VarChar(30) // DRAFT, SUBMITTED, IN_REVIEW, APPROVED, REVISION_REQUESTED, REVISED
  version         Int       @default(1)
  is_ai_generated Boolean   @default(false)
  generation_run_id String? @db.Uuid
  created_by      String    @db.Uuid
  submitted_at    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  section         DedSection @relation(fields: [section_id], references: [id], onDelete: Cascade)
  versions        DedResponseVersion[]
  evidenceRefs    DedEvidenceReference[]
  reviews         DedReview[]
  generationRun   AiGenerationRun? @relation(fields: [generation_run_id], references: [id])

  @@index([section_id, version])
  @@map("ded_responses")
}

model DedResponseVersion {
  id              String    @id @default(uuid()) @db.Uuid
  response_id     String    @db.Uuid
  version_no      Int
  content         String    @db.Text
  status          String    @db.VarChar(30)
  change_summary  String?   @db.VarChar(500)
  created_by      String    @db.Uuid
  created_at      DateTime  @default(now())

  response        DedResponse @relation(fields: [response_id], references: [id], onDelete: Cascade)

  @@index([response_id, version_no])
  @@map("ded_response_versions")
}

model DedEvidenceReference {
  id              String    @id @default(uuid()) @db.Uuid
  response_id     String    @db.Uuid
  chunk_id        String?   @db.Uuid
  document_id     String?   @db.Uuid
  page_number     Int?
  quote           String?   @db.Text
  relevance_score Float?
  created_at      DateTime  @default(now())

  response        DedResponse @relation(fields: [response_id], references: [id], onDelete: Cascade)

  @@map("ded_evidence_references")
}

model AiGenerationRun {
  id              String    @id @default(uuid()) @db.Uuid
  section_id      String    @db.Uuid
  project_id      String    @db.Uuid
  status          String    @default("RUNNING") @db.VarChar(30) // RUNNING, COMPLETED, FAILED
  model_name      String    @db.VarChar(100)
  retrieval_method String   @db.VarChar(30) // HYBRID_RRF, SEMANTIC_ONLY, BM25_ONLY
  retrieval_config Json?
  top_k           Int       @default(10)
  instruction     String?   @db.Text
  generated_text  String?   @db.Text
  retrieved_chunks Json?    // snapshot of retrieved chunks
  error_message   String?   @db.Text
  duration_ms     Int?
  created_by      String    @db.Uuid
  created_at      DateTime  @default(now())
  completed_at    DateTime?

  responses       DedResponse[]

  @@index([section_id])
  @@index([project_id])
  @@map("ai_generation_runs")
}

// =============================================
// Phase 5: Review Workflow
// =============================================

model DedReview {
  id              String    @id @default(uuid()) @db.Uuid
  response_id     String    @db.Uuid
  reviewer_id     String    @db.Uuid
  status          String    @db.VarChar(30) // APPROVED, REVISION_REQUESTED
  overall_comment String?   @db.Text
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  response        DedResponse @relation(fields: [response_id], references: [id], onDelete: Cascade)
  issues          DedReviewIssue[]

  @@index([response_id])
  @@index([reviewer_id])
  @@map("ded_reviews")
}

model DedReviewIssue {
  id              String    @id @default(uuid()) @db.Uuid
  review_id       String    @db.Uuid
  issue_text      String    @db.Text
  status          String    @default("OPEN") @db.VarChar(30) // OPEN, RESOLVED
  resolved_at     DateTime?
  created_at      DateTime  @default(now())

  review          DedReview @relation(fields: [review_id], references: [id], onDelete: Cascade)

  @@index([review_id])
  @@map("ded_review_issues")
}

// =============================================
// Phase 6: Research Workflow
// =============================================

model Dataset {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(200)
  description     String?   @db.Text
  status          String    @default("DRAFT") @db.VarChar(30) // DRAFT, REVIEW, READY, ARCHIVED
  created_by      String    @db.Uuid
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  testCases       DatasetTestCase[]
  experiments     Experiment[]

  @@map("datasets")
}

model DatasetTestCase {
  id              String    @id @default(uuid()) @db.Uuid
  dataset_id      String    @db.Uuid
  question        String    @db.Text
  expected_answer String    @db.Text
  criteria_id     String?   @db.Uuid
  dimension_id    String?   @db.Uuid
  indicator_id    String?   @db.Uuid
  evidence_refs   Json?
  status          String    @default("DRAFT") @db.VarChar(30) // DRAFT, NEEDS_REVIEW, READY
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  dataset         Dataset   @relation(fields: [dataset_id], references: [id], onDelete: Cascade)
  results         ExperimentTestCaseResult[]

  @@index([dataset_id])
  @@map("dataset_test_cases")
}

model Experiment {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(200)
  dataset_id      String    @db.Uuid
  method          String    @db.VarChar(50) // LLM_ONLY, SEMANTIC_RAG, HYBRID_RAG
  model_name      String    @db.VarChar(100)
  evidence_first  Boolean   @default(true)
  retrieval_config Json?
  status          String    @default("DRAFT") @db.VarChar(30) // DRAFT, QUEUED, RUNNING, COMPLETED, FAILED, CANCELLED
  created_by      String    @db.Uuid
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  dataset         Dataset   @relation(fields: [dataset_id], references: [id], onDelete: Cascade)
  runs            ExperimentRun[]

  @@map("experiments")
}

model ExperimentRun {
  id              String    @id @default(uuid()) @db.Uuid
  experiment_id   String    @db.Uuid
  status          String    @default("QUEUED") @db.VarChar(30)
  started_at      DateTime?
  completed_at    DateTime?
  error_message   String?   @db.Text

  experiment      Experiment @relation(fields: [experiment_id], references: [id], onDelete: Cascade)
  results         ExperimentTestCaseResult[]
  metrics         ExperimentMetric[]

  @@index([experiment_id])
  @@map("experiment_runs")
}

model ExperimentTestCaseResult {
  id                  String    @id @default(uuid()) @db.Uuid
  run_id              String    @db.Uuid
  test_case_id        String    @db.Uuid
  generated_answer    String?   @db.Text
  retrieved_chunk_ids String[]  @db.Uuid
  retrieval_scores    Json?
  context_text        String?   @db.Text
  faithfulness        Decimal?  @db.Decimal(8,6)
  answer_relevancy    Decimal?  @db.Decimal(8,6)
  context_precision   Decimal?  @db.Decimal(8,6)
  context_recall      Decimal?  @db.Decimal(8,6)
  duration_ms         Int?
  error_message       String?   @db.Text
  created_at          DateTime  @default(now())

  run                 ExperimentRun   @relation(fields: [run_id], references: [id], onDelete: Cascade)
  testCase            DatasetTestCase @relation(fields: [test_case_id], references: [id], onDelete: Cascade)

  @@unique([run_id, test_case_id])
  @@map("experiment_test_case_results")
}

model ExperimentMetric {
  id              String    @id @default(uuid()) @db.Uuid
  run_id          String    @db.Uuid
  metric_name     String    @db.VarChar(50) // FAITHFULNESS, ANSWER_RELEVANCY, etc.
  mean_score      Decimal   @db.Decimal(8,6)
  median_score    Decimal   @db.Decimal(8,6)
  std_dev         Decimal   @db.Decimal(8,6)
  created_at      DateTime  @default(now())

  run             ExperimentRun @relation(fields: [run_id], references: [id], onDelete: Cascade)

  @@index([run_id])
  @@map("experiment_metrics")
}

// =============================================
// Phase 7: System & Polish
// =============================================

model Notification {
  id              String    @id @default(uuid()) @db.Uuid
  user_id         String    @db.Uuid
  type            String    @db.VarChar(50)
  title           String    @db.VarChar(200)
  message         String    @db.Text
  link            String?   @db.VarChar(500)
  priority        String    @default("NORMAL") @db.VarChar(20) // NORMAL, HIGH
  is_read         Boolean   @default(false)
  read_at         DateTime?
  created_at      DateTime  @default(now())

  user            User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read, created_at])
  @@map("notifications")
}

model UserNotificationPreference {
  id                String    @id @default(uuid()) @db.Uuid
  user_id           String    @db.Uuid
  notification_type String    @db.VarChar(80)
  in_app_enabled    Boolean   @default(true)
  email_enabled     Boolean   @default(false)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  user              User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, notification_type])
  @@map("user_notification_preferences")
}

model AuditLog {
  id              String    @id @default(uuid()) @db.Uuid
  user_id         String?   @db.Uuid
  action          String    @db.VarChar(100)
  resource_type   String    @db.VarChar(50)
  resource_id     String?   @db.VarChar(100)
  details         Json?
  ip_address      String?   @db.VarChar(50)
  created_at      DateTime  @default(now())

  user            User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([resource_type, resource_id])
  @@index([created_at])
  @@map("audit_logs")
}

model DedStructureTemplate {
  id                    String    @id @default(uuid()) @db.Uuid
  instrument_version_id String    @db.Uuid // NOTE: Linking as string instead of relation since InstrumentVersion model might be absorbed in Instrument tree, depending on Phase 2 impl. If not defined, we'll leave as String.
  parent_id             String?   @db.Uuid
  code                  String    @db.VarChar(100)
  title                 String    @db.VarChar(500)
  section_type          String    @db.VarChar(50) // COVER, INTRO, CRITERION, APPENDIX, OTHER
  description           String?   @db.Text
  criterion_mapping     String?   @db.VarChar(50)
  display_order         Int
  is_required           Boolean   @default(true)
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  parent                DedStructureTemplate?  @relation("DedTemplateTree", fields: [parent_id], references: [id])
  children              DedStructureTemplate[] @relation("DedTemplateTree")

  @@unique([instrument_version_id, code])
  @@index([instrument_version_id, display_order])
  @@map("ded_structure_templates")
}

model SystemSetting {
  id              String    @id @default(uuid()) @db.Uuid
  key             String    @unique @db.VarChar(100)
  value           String    @db.Text
  description     String?   @db.Text
  updated_by      String?   @db.Uuid
  updated_at      DateTime  @updatedAt

  @@map("system_settings")
}
